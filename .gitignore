# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Environment
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project runtime artifacts
/world/
# Per-run worlds, from the 2026-09-20 change that stopped each run deleting
# the last one's. /world/ was ignored and this replacement was not, so 145
# files of run output were committed before anyone looked. The archive of what
# a run produced is research_logs/<run>/ — artifacts and diffs, append-only.
# This directory is working state.
/world_runs/
research_logs/
knowledge_bases/self_history/

# Large model files
*.bin
*.onnx
*.safetensors

# Raw corpus source files (regenerate with scripts/fetch_corpus.py)
raw_corpus/

# Rendered from prompts_src/ and world_template_src/ per run
/prompts/
/world_template/

# Never again: a sed backup of .env was committed to a public repo.
.env.*
!.env.example
