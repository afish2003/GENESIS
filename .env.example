# =============================================================================
# GENESIS Configuration — Dell OptiPlex 7090 (Controller)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is read by the controller on the OptiPlex.
# The HP Omen does NOT need this file — it only runs Ollama.
# =============================================================================

# ---------------------------------------------------------------------------
# Inference backend
# ---------------------------------------------------------------------------
# Which backend to use: ollama | openai | mock
#
#   ollama  native Ollama /api/chat (the HP Omen over LAN)
#   openai  ANY OpenAI-compatible /v1 endpoint — see table below
#   mock    no model at all; runs the full cycle loop for validation
#
# Override per-run without editing this file:
#   python -m controller.main ... --backend openai --model <name> --api-base-url <url>
INFERENCE_BACKEND=ollama

# Model identifier, as the chosen endpoint expects it.
MODEL_NAME=qwen2.5:32b-instruct-q4_K_M

# --- when INFERENCE_BACKEND=ollama ------------------------------------------
# The HP Omen's LAN IP. Find it with `ipconfig` (Win) or `ip addr show` (Linux).
OLLAMA_HOST=http://<OMEN_LAN_IP>:11434

# --- when INFERENCE_BACKEND=openai ------------------------------------------
# Endpoint root, INCLUDING /v1. One class covers all of these:
#
#   OpenAI      https://api.openai.com/v1          key required
#   Ollama      http://<host>:11434/v1             no key
#   LM Studio   http://localhost:1234/v1           no key
#   llama.cpp   http://localhost:8080/v1           no key
#   vLLM        http://<host>:8000/v1              no key
#   Groq        https://api.groq.com/openai/v1     key required
#   OpenRouter  https://openrouter.ai/api/v1       key required
#   Together    https://api.together.xyz/v1        key required
#
API_BASE_URL=http://localhost:11434/v1

# Bearer token. Leave unset for local servers — the header is then omitted
# entirely, which is what they expect. OPENAI_API_KEY also works.
# API_KEY=

# Send response_format={"type":"json_object"}. Improves structured-output
# reliability where supported, but not every server accepts it. Default off.
API_JSON_MODE=false

# Per-request timeout in seconds.
REQUEST_TIMEOUT=600

# ---------------------------------------------------------------------------
# Paths (relative to repo root — defaults work for standard setup)
# ---------------------------------------------------------------------------
WORLD_DIR=./world
# WORLD_TEMPLATE_DIR is deliberately NOT set. Setting it makes every run COPY
# that directory verbatim instead of rendering world_template_src, so edits to
# the source never reach a run. It shipped here pointing at ./world_template —
# the gitignored BUILD OUTPUT — and as a result the whole of the 2026-09-20
# battery ran against a template last written on 14 September, including a
# manifesto fix that had been committed, tested and believed to be in effect.
# Set it only to a hand-written template you intend to use verbatim.
# WORLD_TEMPLATE_DIR=
RESEARCH_LOGS_DIR=./research_logs
PROMPTS_DIR=./prompts
KNOWLEDGE_BASES_DIR=./knowledge_bases

# ---------------------------------------------------------------------------
# Retrieval system
# ---------------------------------------------------------------------------
# Embedding model for reranking (runs on CPU on the OptiPlex)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# BM25 candidate pool → reranked to top-k
BM25_CANDIDATE_POOL=20
RERANK_TOP_K=5

# ---------------------------------------------------------------------------
# Inference temperatures
# ---------------------------------------------------------------------------
# Discussion/reflection phases: higher for varied, natural output
TEMPERATURE_DISCUSSION=0.7

# Structured output phases (evaluation, memory, schemas): lower for reliability
TEMPERATURE_STRUCTURED=0.3

# ---------------------------------------------------------------------------
# Experiment axes
# ---------------------------------------------------------------------------
# The agent roster, comma-separated. Each entry needs prompts_src/<name>_system.md
# and world_template_src/doctrine/identity_<name>.md.
# AGENTS=axiom,flux

# What the agents build each cycle: protocol | code
# TASK=protocol

# Whether the agents are told they are in a research experiment.
# disclosed | undisclosed
# FRAMING=disclosed

# How much identity is given rather than developed: prescribed | minimal
# IDENTITY_SEED=prescribed

# Cycles at which to inject scenario events, comma-separated.
# SCENARIO_INJECTION_CYCLES=20,40,60,80

# Phase order. Omit for the default 14-phase sequence; validated on load.
# PHASE_SEQUENCE=load_state,reflection,discussion,persist_state

# Draft doctrine proposals without the shared discussion history.
# INDEPENDENT_PROPOSALS=false

# replace writes the agent's full revised document (correct).
# append reproduces the pre-2026-09-13 behaviour and should not be used.
# DOCTRINE_APPLY_MODE=replace

# ---------------------------------------------------------------------------
# Monitoring and safety
# ---------------------------------------------------------------------------
# Deterministic anomaly rules after each cycle. Invisible to the agents.
# WATCHDOG_ENABLED=true

# Abort the run when the watchdog reports a CRITICAL anomaly.
# HALT_ON_CRITICAL_ANOMALY=false

# Execution of agent-authored code: null refuses everything (default).
# Enabling docker is gated on docs/containment_design.md's checklist.
# SANDBOX_BACKEND=null

# --- Code execution (OFF by default; read docs/containment_design.md first) ---
# Two separate switches on purpose: the first adds the phase, the second gives
# it a runtime that is not a refusal. Run scripts/verify_containment.py on this
# host before setting either.
# EXECUTION_ENABLED=false
# SANDBOX_BACKEND=null              # null | docker
# SANDBOX_IMAGE=python:3.11-slim    # must be pulled already; the sandbox has no network
# SANDBOX_RUNTIME=docker            # docker | podman
# SANDBOX_MEMORY=2g                # container memory AND scratch ceiling:
#                                  # /tmp is the only writable filesystem and is
#                                  # RAM-backed, so this one number bounds both.
#                                  # 2g leaves ~1.7 GiB of scratch. Cannot usefully
#                                  # exceed what the runtime has — Docker Desktop's
#                                  # VM allocation, not the host's.
# SANDBOX_TMPFS=                   # override /tmp size; defaults to SANDBOX_MEMORY
#
# Persistent storage, for agents building a codebase across cycles. Mounted at
# /project and used as the working directory. MUST be its own size-capped
# filesystem — a Docker bind mount has no size limit and the controller refuses
# an ordinary directory. Create one with:
#   python scripts/setup_project_volume.py --path ~/genesis_project --size 32g
# SANDBOX_PROJECT_DIR=
# SANDBOX_PROJECT_SIZE=32g
# SANDBOX_TIMEOUT_SECONDS=30
