# =============================================================================
# GENESIS — local development configuration (this Mac)
# =============================================================================
# Local Ollama on the M2 Pro, via its OpenAI-compatible /v1 endpoint.
# For the real study, switch INFERENCE_BACKEND to ollama and point
# OLLAMA_HOST at the HP Omen, then set MODEL_NAME to the 32b checkpoint.
# =============================================================================

INFERENCE_BACKEND=openai
API_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5:7b-instruct
# No API_KEY — local Ollama needs none, and the header is omitted entirely.

# Ollama's /v1 shim supports JSON mode; it materially improves schema
# compliance, which is the main thing a small model gets wrong.
API_JSON_MODE=true

# A 7B on an M2 Pro is far slower than a 5090. Generous per-request ceiling.
REQUEST_TIMEOUT=600

# --- the real study target (unused while INFERENCE_BACKEND=openai) ----------
OLLAMA_HOST=http://192.168.1.100:11434

# --- paths -----------------------------------------------------------------
WORLD_DIR=./world
WORLD_TEMPLATE_DIR=./world_template
RESEARCH_LOGS_DIR=./research_logs
PROMPTS_DIR=./prompts
KNOWLEDGE_BASES_DIR=./knowledge_bases

# --- retrieval -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BM25_CANDIDATE_POOL=20
RERANK_TOP_K=5

# --- inference temperatures ------------------------------------------------
TEMPERATURE_DISCUSSION=0.7
TEMPERATURE_STRUCTURED=0.3
API_KEY=sk-i5-e_AScCzUpOAjCZlSwag
